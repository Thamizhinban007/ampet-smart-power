# Copy to .env and fill in real values before deploying anywhere reachable
# outside localhost. Never commit the real .env file.

# Required in production: protects every /api/* route (and the legacy
# /data, /update_consumer, /update_feeder routes) behind an X-API-Key header.
# Leave unset for local development to skip auth.
AMPET_API_KEY=

# Optional: restrict CORS to your actual frontend origin instead of "*".
AMPET_CORS_ORIGINS=*

# Optional: set to true to run Flask's dev server with debug/reloader on.
# Never enable in production.
FLASK_DEBUG=false

# Optional: override the SQLite path, e.g. for a managed Postgres URL.
# DATABASE_URL=sqlite:////absolute/path/to/ampet.db
